{
  "$defs": {
    "Change": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "replace",
            "add",
            "remove",
            "field"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "before": {
          "title": "Before"
        },
        "after": {
          "title": "After"
        },
        "rationale": {
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "target",
        "before",
        "after",
        "rationale",
        "evidence"
      ],
      "title": "Change",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "document",
        "start",
        "end",
        "quote",
        "locator"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 8,
          "title": "Question",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question",
        "evidence"
      ],
      "title": "Question",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "disposition": {
          "enum": [
            "change",
            "unaffected",
            "question"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "changes": {
          "items": {
            "type": "string"
          },
          "title": "Changes",
          "type": "array"
        },
        "reason": {
          "minLength": 8,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "evidence",
        "disposition",
        "reason"
      ],
      "title": "Section",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "agreement",
            "amendment"
          ],
          "title": "Role",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "path",
        "sha256"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 5,
      "title": "Title",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "effective_on": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective On"
    },
    "execution_status": {
      "enum": [
        "confirmed",
        "unconfirmed"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "effect_basis": {
      "minLength": 8,
      "title": "Effect Basis",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 2,
      "title": "Sources",
      "type": "array"
    },
    "baseline": {
      "additionalProperties": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Baseline",
      "type": "object"
    },
    "baseline_notice": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "baseline_business_day_rule": {
      "anyOf": [
        {
          "$ref": "#/$defs/Evidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "as_of",
    "effective_on",
    "execution_status",
    "effect_basis",
    "sources",
    "baseline",
    "sections",
    "changes"
  ],
  "title": "AmendmentPlan",
  "type": "object"
}
